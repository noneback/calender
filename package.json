{
  "name": "market-calendar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "build": "npm run check && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "sync": "node --experimental-strip-types scripts/sync.ts",
    "verify:feed": "node --experimental-strip-types scripts/verify-feed.ts"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "cheerio": "^1.2.0",
    "csv-parse": "^7.0.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
